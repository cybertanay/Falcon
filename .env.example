# ==============================================================================
# FALCON INTERNATIONAL TRADERS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTICE: This file is a TEMPLATE only and contains NO real secrets or credentials.
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# CRITICAL SECURITY RULES:
# 1. NEVER commit real '.env' files, API keys, passwords, or secrets to Git.
# 2. In production, configure all variables via your secure hosting provider's
#    environment secret manager (e.g. Render, Railway, AWS SSM, Vercel).
# 3. All production credentials MUST be verified and supplied by Falcon's
#    human development/operations team prior to deployment.
# ==============================================================================

# Node Runtime Environment ('development' | 'production' | 'test')
# When set to 'production', the backend strictly requires SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY, SESSION_SECRET, and admin credentials.
NODE_ENV="development"
PORT=3000

# Application Canonical URL
# Local: http://localhost:3000
# Production: https://yourdomain.com (used for CORS and transactional email links)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# PostgreSQL & Supabase Database Configuration
# ------------------------------------------------------------------------------
# Production requires a live Supabase / PostgreSQL instance running schema.sql.
# SUPABASE_URL: Project HTTPS URL from Supabase Project Settings -> API
# SUPABASE_SERVICE_ROLE_KEY: Secret service_role API key for privileged backend CRUD
# DATABASE_URL: Standard PostgreSQL direct connection URI (optional, for migrations)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# ------------------------------------------------------------------------------
# Authentication & Session Security
# ------------------------------------------------------------------------------
# SESSION_SECRET: Cryptographically secure random secret (min 32 chars)
# Used for signing HttpOnly admin JWT cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Initial Administrative User Bootstrap
# On first startup with PostgreSQL/Supabase, if no admin user exists,
# an initial super_admin account is seeded using these credentials.
# The password is automatically hashed with bcrypt (salt rounds = 12).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# Transactional Email Service (Resend)
# ------------------------------------------------------------------------------
# Used for automated buyer quote confirmation emails and trade desk alerts.
# Obtain API key from https://resend.com after verifying your sending domain.
RESEND_API_KEY=""

# ------------------------------------------------------------------------------
# Google Gemini API (Technical AI Export Specification Assistant)
# ------------------------------------------------------------------------------
# Used exclusively by the server-side AI export advisor (/api/ai/spec-assist).
# Generates indicative mesh sizes, moisture thresholds, and packaging guidance.
# Obtain key from Google Cloud Console or Google AI Studio.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# Rate Limiting & Development Testing Controls
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production), rate limiting is strictly locked at 20/hr
# per IP and cannot be disabled.
# In local development only, developers may relax or disable rate limiting:
# Set ENQUIRY_RATE_LIMIT_ENABLED="false" for unlimited local QA submissions.
# Set ENQUIRY_RATE_LIMIT_MAX="100" (default in dev) to raise local threshold.
ENQUIRY_RATE_LIMIT_ENABLED="true"
ENQUIRY_RATE_LIMIT_MAX="100"

# ------------------------------------------------------------------------------
# Company Trade Desk Contact Info (Placeholders — Verify with Management)
# ------------------------------------------------------------------------------
# Official inbound trade desk email for customer enquiries and BCC notifications.
BUSINESS_EMAIL="export@falconspices.com"

# Official international WhatsApp Business contact number with country code.
WHATSAPP_NUMBER="+919876543210"
